<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Okviri.Api</RootNamespace>
    <!-- dotnet user-secrets: tajne izvan repozitorija (%APPDATA%\Microsoft\UserSecrets\<id>\secrets.json) -->
    <UserSecretsId>secure-coding-akademija-okviri</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
  </ItemGroup>

</Project>
