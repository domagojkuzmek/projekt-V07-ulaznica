{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",

  // JWT od Keycloaka: potpis (JWKS), iss, aud i rok valjanosti provjerava JwtBearer.
  "Keycloak": {
    "Authority": "http://localhost:8180/realms/akademija",
    "Audience": "medtermin-api",
    "RequireHttpsMetadata": true
  },

  // Isto značenje kao App:Cors:AllowedOrigins u T2.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  // Lokalna prijava: najviše N pokušaja u minuti po IP adresi.
  "Prijava": {
    "PokusajaUMinuti": 5
  },

  // Obavijesti:ApiKljuc NIJE ovdje – to je tajna (dotnet user-secrets / varijabla okruženja).
  "Obavijesti": {
    "Adresa": "https://obavijesti.example/api/"
  }
}
