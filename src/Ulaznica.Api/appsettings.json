{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // In-memory SQLite baza; {guid} se pri svakom pokretanju zamjenjuje novom vrijednošću.
  "ConnectionStrings": {
    "Default": "Data Source=ulaznica-{guid};Mode=Memory;Cache=Shared"
  },

  "App": {
    // Relativne putanje računaju se od mape projekta (src/Ulaznica.Api).
    "StorageDir": "./data/dokumenti",
    "MailboxDir": "./data/posta",
    "PublicUrl": "http://localhost:5080",
    "Cors": {
      "AllowedOrigins": [ "http://localhost:5173" ]
    }
  }
}
